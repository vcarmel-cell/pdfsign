rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'v.carmel@gmail.com';
    }
    function signedIn() {
      return request.auth != null;
    }
    // משתמש רגיל (לא המנהל הראשי) - מזוהה דרך מסמך users/{uid} פעיל.
    function isActiveUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    // רלוונטי רק לתבניות/הגשות ישנות (מלפני שהוספנו Firebase Storage) שעדיין
    // שומרות PDF כ-Base64 בתוך המסמך עצמו - אלה חייבות להישאר קטנות מספיק
    // כדי לא לחרוג ממגבלת 1MB למסמך ב-Firestore. תבניות/הגשות חדשות נשמרות
    // ב-Storage (pdfUrl/pdfStoragePath) ולא נוגעות בבדיקה הזו כלל.
    function pdfFieldOk(data) {
      return !('pdfBase64' in data) || data.pdfBase64.size() < 750000;
    }

    match /users/{userId} {
      // get פתוח לכל מחובר (כולל אנונימי) לפי מזהה ידוע - כמו templates.get -
      // כדי שממלא אנונימי יוכל לבדוק את מכסת ה-99 הגשות של בעל התבנית לפני
      // שהוא שולח הגשה חדשה (ראו submissionCount למטה).
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.role == 'user'
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (
        isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
      ) || (
        // עדכון מצומצם של submissionCount בלבד, בדיוק ב-1 - מאפשר גם לבעל
        // החשבון (במחיקת הגשה) וגם לכל מחובר אחר (ממלא אנונימי, ביצירת
        // הגשה חדשה) לעדכן את המונה, בלי לגעת בשום שדה אחר במסמך.
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submissionCount'])
        && (
          (request.auth.uid == userId && request.resource.data.submissionCount == resource.data.submissionCount - 1)
          || request.resource.data.submissionCount == resource.data.submissionCount + 1
        )
      );
      allow delete: if isAdmin();
    }

    match /templates/{templateId} {
      allow get: if signedIn();
      allow list: if isAdmin() || (isActiveUser() && resource.data.ownerId == request.auth.uid);
      allow create: if (isAdmin() || isActiveUser())
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && pdfFieldOk(request.resource.data);
      allow update: if pdfFieldOk(request.resource.data) && (
        isAdmin() ||
        (isActiveUser() && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.ownerEmail == resource.data.ownerEmail)
      );
      allow delete: if isAdmin() || (isActiveUser() && resource.data.ownerId == request.auth.uid);
    }

    match /submissions/{submissionId} {
      function realTemplateOf(data) {
        return get(/databases/$(database)/documents/templates/$(data.templateId)).data;
      }

      // מצב "single" (ברירת מחדל, לא השתנה) - ממלא אנונימי יוצר הגשה גמורה
      // אחת ומיד, לא ניתן לעריכה אחר כך.
      function singleCreateAllowed(data) {
        return data.status == 'completed'
          && data.templateId is string
          && data.filledBy is string
          && data.ownerId is string
          && data.ownerId == realTemplateOf(data).ownerId
          && data.createdAt == request.time;
      }

      // מצב "multiSign" - רק הבעלים (מנהל/משתמש פעיל) יכול לפתוח סבב חתימות
      // חדש וריק; ממלאים אנונימיים רק מעדכנים אותו אח"כ (allow update למטה).
      function multiSignCreateAllowed(data) {
        return data.status == 'in_progress'
          && data.templateId is string
          && data.ownerId is string
          && (isAdmin() || (isActiveUser() && data.ownerId == request.auth.uid))
          && data.ownerId == realTemplateOf(data).ownerId
          && realTemplateOf(data).get('mode', 'single') == 'multiSign'
          && data.values == {} && data.signerNames == {} && data.rawSignatures == {}
          && !('pdfBase64' in data)
          && data.createdAt == request.time;
      }

      // בדיקה ש-Map לא איבד/שינה מפתחות קיימים - רק תוספת מותרת (חותם לא יכול
      // לדרוס/למחוק את מה שחותם אחר כבר שמר).
      function additiveMapUpdate(beforeMap, afterMap) {
        let d = beforeMap.diff(afterMap);
        return d.removedKeys().size() == 0 && d.changedKeys().size() == 0;
      }

      // עדכון חלקי של חותם אנונימי בסבב "multiSign" פעיל: מוסיף רק את החתימה/
      // שם/ערכים משותפים שלו, או (בכתיבה האחת שמשלימה את הסבב) מטביע PDF סופי.
      function isSignerPartialUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let affected = after.diff(before).affectedKeys();
        return signedIn()
          && before.mode == 'multiSign'
          && affected.hasOnly(['values', 'signerNames', 'rawSignatures', 'status', 'completedAt', 'pdfBase64', 'pdfUrl', 'pdfStoragePath'])
          && after.ownerId == before.ownerId && after.templateId == before.templateId && after.mode == before.mode
          && (
            (before.status == 'in_progress' && (after.status == 'in_progress' || after.status == 'completing')
              && !('pdfBase64' in after) && !('completedAt' in after)
              && additiveMapUpdate(before.values, after.values)
              && additiveMapUpdate(before.signerNames, after.signerNames)
              && additiveMapUpdate(before.rawSignatures, after.rawSignatures))
            ||
            // pdfBase64 נשאר אופציונלי (כמו במצב single) - אם המסמך הסופי
            // חורג מהמכסה, ההשלמה עדיין מותרת בלי עותק שמור במערכת;
            // pdfFieldOk() כבר נבדק על כל ה-update למעלה בכל מקרה.
            (before.status == 'completing' && after.status == 'completed'
              && after.values == before.values && after.signerNames == before.signerNames
              && !('rawSignatures' in after)
              && after.completedAt == request.time)
          );
      }

      allow get, list: if isAdmin() || (isActiveUser() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && pdfFieldOk(request.resource.data) && (
        (request.resource.data.mode == 'single' && singleCreateAllowed(request.resource.data)) ||
        (request.resource.data.mode == 'multiSign' && multiSignCreateAllowed(request.resource.data))
      );
      allow update: if pdfFieldOk(request.resource.data) && (
        isAdmin()
        || (isActiveUser() && resource.data.ownerId == request.auth.uid)
        || isSignerPartialUpdate()
      );
      allow delete: if isAdmin() || (isActiveUser() && resource.data.ownerId == request.auth.uid);
    }
  }
}
